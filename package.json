{
  "name": "soundboard",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve web",
    "build": "nx build web",
    "build:deploy": "node tools/write-environment.mjs && nx build web --configuration=deploy",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "e2e": "nx e2e web-e2e",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > libs/supabase/data-access/src/lib/database.types.ts && prettier --write libs/supabase/data-access/src/lib/database.types.ts",
    "check": "nx run-many -t lint test build && prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-server": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@angular/ssr": "~22.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "express": "^4.21.2",
    "rxjs": "~7.8.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.5",
    "@analogjs/vitest-angular": "2.7.5",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.0",
    "@nx/devkit": "24.0.0",
    "@nx/docker": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/node": "24.0.0",
    "@nx/playwright": "24.0.0",
    "@nx/rolldown": "24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.1",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "rolldown": "^1.2.0",
    "supabase": "^3.2.0",
    "supertest": "^7.1.4",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "8.3.5",
    "vitest": "^5.1.0",
    "@angular-devkit/architect": "~0.2202.8"
  },
  "packageManager": "pnpm@10.29.3",
  "lint-staged": {
    "*.{html,js,ts,mjs,mts}": [
      "prettier --write"
    ],
    "*.{css,json,md,scss,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@angular-devkit/architect": "~0.2202.8",
      "@angular-devkit/core": "~22.2.8"
    }
  }
}
